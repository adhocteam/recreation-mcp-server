# Ignore Git files
.git/
.gitignore

# Ignore documentation and markdown files
*.md
spec/

# Ignore test files
*_test.go
test/
coverage.out
coverage.html

# Ignore CI/CD files
.github/
.gitlab-ci.yml

# Ignore environment files
.env
.env.*

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore temporary files
tmp/
temp/

# Ignore logs
*.log
