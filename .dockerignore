# Ignore Git files
.git/
.gitignore

# Ignore documentation and markdown files
*.md
spec/

# Ignore test files
*_test.go
test/
testdata/
coverage.out
coverage.html
*.test

# Ignore CI/CD files
.github/
.gitlab-ci.yml

# Ignore environment files
.env
.env.*
!.env.example
config.yaml

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore temporary files
tmp/
temp/

# Ignore logs
*.log

# Ignore Docker files (not needed in build context)
Dockerfile*
docker-compose*.yml
.dockerignore

# Ignore build artifacts
mcp-server
*.exe
*.dll
*.so
*.dylib
bin/
dist/
vendor/
.cache/
